{
  "name": "fault-lines-atlas",
  "version": "3.0.0-dev",
  "private": true,
  "description": "Fault Lines Atlas (أطلس خطوط الصدع): an open-source, bilingual atlas of the world's political, ethnic and religious geography",
  "license": "MIT",
  "type": "module",
  "repository": "github:muradalshorman987/fault-lines-atlas",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "check-data": "tsx scripts/check-data.ts",
    "migrate-errata": "tsx scripts/migrate-errata.ts",
    "format-data": "tsx scripts/format-data.ts",
    "test:e2e": "playwright test",
    "data:update": "tsx scripts/data/update.ts"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
